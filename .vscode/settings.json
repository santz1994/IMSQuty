{
    "sqltools.connections": [
        {
            "mysqlOptions": {
                "authProtocol": "default",
                "enableSsl": "Disabled"
            },
            "ssh": "Disabled",
            "previewLimit": 50,
            "server": "127.0.0.1",
            "port": 3306,
            "driver": "MySQL",
            "database": "imsquty",
            "username": "root",
            "name": "IMSQUTY",
            "password": ""
        }
    ],
    // GitHub Copilot Settings
    "github.copilot.enable": {
        "*": true,
        "plaintext": true,
        "markdown": true,
        "scminput": false
    },
    "github.copilot.chat.codeGeneration.instructions": [
        {
            "text": "Project: imsquty Microservices (Laravel Monolith → 10 Microservices). Team: 1-2 senior devs. Budget: $2.8K total. Local deployment only (Docker). Shared MySQL DB. Compliance: ISO+GDPR+SOC2. Priority: Ticket→User→Meeting Room. Timeline: 18 months. Docs: z:/htdocs/quty2/docs/task/"
        },
        {
            "text": "Stack: Laravel 10+/PHP 8.1+, JWT, Spatie RBAC, React 18/TypeScript/Redux/MUI, Docker Compose, MySQL 8, Redis, RabbitMQ. NO cloud, NO paid tools, NO K8s. 100% open-source."
        },
        {
            "text": "Code: Thin controllers, service+repository pattern, 80%+ tests, audit logging mandatory, PSR-12, PHPDoc, API Resources, Form Requests. Security: JWT+refresh, RBAC, log all CUD ops, GDPR export/delete, rate limiting."
        },
        {
            "text": "Generate: Always include validation, error handling, audit logs, tests, docs. Use DI, return API Resources, write feature tests. Format: {success, data/error, message}"
        }
    ],
    // File Associations
    "files.associations": {
        "*.blade.php": "blade",
        ".env.example": "dotenv",
        "docker-compose.yml": "yaml",
        "Dockerfile": "dockerfile"
    },
    // Editor Settings
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
        "source.fixAll": "explicit",
        "source.organizeImports": "explicit"
    },
    // PHP Settings
    "[php]": {
        "editor.defaultFormatter": "bmewburn.vscode-intelephense-client",
        "editor.tabSize": 4,
        "editor.insertSpaces": true
    },
    "php.suggest.basic": false,
    "intelephense.stubs": [
        "apache",
        "bcmath",
        "Core",
        "curl",
        "date",
        "dom",
        "fileinfo",
        "json",
        "mbstring",
        "mysqli",
        "openssl",
        "PDO",
        "pdo_mysql",
        "redis",
        "session",
        "tokenizer",
        "zip"
    ],
    // TypeScript/JavaScript Settings
    "[typescript]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.tabSize": 2
    },
    "[typescriptreact]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.tabSize": 2
    },
    "[javascript]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.tabSize": 2
    },
    "[json]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.tabSize": 2
    },
    "typescript.preferences.importModuleSpecifier": "relative",
    "typescript.updateImportsOnFileMove.enabled": "always",
    // Search & File Watching
    "search.exclude": {
        "**/node_modules": true,
        "**/vendor": true,
        "**/storage": true,
        "**/bootstrap/cache": true,
        "**/.git": true
    },
    "files.watcherExclude": {
        "**/node_modules/**": true,
        "**/vendor/**": true,
        "**/storage/**": true,
        "**/bootstrap/cache/**": true
    },
    // Spell Check
    "cSpell.words": [
        "imsquty",
        "microservices",
        "Spatie",
        "Eloquent",
        "PHPUnit",
        "Laravel",
        "middlewares",
        "seeders",
        "RBAC",
        "GDPR"
    ]
}