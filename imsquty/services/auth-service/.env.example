APP_NAME="IMSQuty Auth Service"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8001

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Shared Database Configuration
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=imstest_quty
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=redis
FILESYSTEM_DISK=local
QUEUE_CONNECTION=rabbitmq
SESSION_DRIVER=redis
SESSION_LIFETIME=120

# Redis Configuration
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# RabbitMQ Configuration
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USER=imsquty
RABBITMQ_PASSWORD=rabbitmq_pass_123
RABBITMQ_VHOST=/
RABBITMQ_QUEUE=auth_queue

# JWT Configuration
JWT_SECRET=
JWT_TTL=60
JWT_REFRESH_TTL=20160
JWT_ALGO=HS256
JWT_BLACKLIST_ENABLED=true
JWT_BLACKLIST_GRACE_PERIOD=0

# Security
RATE_LIMIT_LOGIN=5
LOCKOUT_ATTEMPTS=10
LOCKOUT_DURATION=900
PASSWORD_MIN_LENGTH=6

# Service URLs
API_GATEWAY_URL=http://imsquty-api-gateway:8000
USER_SERVICE_URL=http://imsquty-user-service:8002
NOTIFICATION_SERVICE_URL=http://imsquty-notification-service:8010

# Audit Logging
AUDIT_LOG_ENABLED=true
AUDIT_LOG_RETENTION_DAYS=365
