{
  "name": "imsquty-mobile-app",
  "version": "1.0.0",
  "description": "IMSQuty Mobile Application - React Native",
  "main": "index.js",
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "start": "react-native start",
    "test": "jest",
    "build:android": "cd android && ./gradlew assembleRelease && cd ..",
    "build:ios": "xcodebuild -workspace ios/imsquty.xcworkspace -scheme imsquty -configuration Release"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-native": "^0.72.0",
    "react-native-screens": "^3.26.0",
    "@react-navigation/native": "^6.1.8",
    "@react-navigation/bottom-tabs": "^6.5.8",
    "@react-navigation/stack": "^6.3.17",
    "react-native-gesture-handler": "^2.14.0",
    "react-native-reanimated": "^3.5.0",
    "@reduxjs/toolkit": "^1.9.7",
    "react-redux": "^8.1.3",
    "react-native-paper": "^5.11.0",
    "axios": "^1.6.2",
    "react-native-qrcode-scanner": "^1.4.2",
    "react-native-camera": "^4.2.1"
  },
  "devDependencies": {
    "@types/react-native": "^0.72.0",
    "typescript": "^5.2.2",
    "jest": "^29.7.0",
    "@testing-library/react-native": "^12.2.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
