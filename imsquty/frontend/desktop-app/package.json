{
  "name": "imsquty-desktop-app",
  "version": "1.0.0",
  "description": "IMSQuty Desktop Application - Electron + React",
  "main": "electron/main.js",
  "homepage": "./",
  "scripts": {
    "react-start": "react-scripts start",
    "react-build": "react-scripts build",
    "react-test": "react-scripts test",
    "react-eject": "react-scripts eject",
    "electron-start": "electron .",
    "start": "concurrently \"npm run react-start\" \"wait-on http://localhost:3000 && npm run electron-start\"",
    "build": "npm run react-build && electron-builder",
    "dev": "concurrently \"npm run react-start\" \"electron .\"",
    "test": "npm run react-test"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.20.0",
    "@reduxjs/toolkit": "^1.9.7",
    "react-redux": "^8.1.3",
    "@mui/material": "^5.14.0",
    "axios": "^1.6.2",
    "electron-squirrel-startup": "^1.1.2"
  },
  "devDependencies": {
    "react-scripts": "5.0.1",
    "electron": "^27.0.0",
    "electron-builder": "^24.6.4",
    "@testing-library/react": "^14.1.2",
    "typescript": "^5.2.2",
    "concurrently": "^8.2.1",
    "wait-on": "^7.0.1"
  },
  "build": {
    "appId": "com.imsquty.desktop",
    "productName": "IMSQuty",
    "files": [
      "build/**/*",
      "node_modules/**/*",
      "electron/**/*"
    ],
    "directories": {
      "buildResources": "public"
    }
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
