# ===========================================
# IMSQUTY MICROSERVICES - Environment Variables
# ===========================================

# MySQL Configuration
MYSQL_ROOT_PASSWORD=root_password_123
MYSQL_DATABASE=imsquty
MYSQL_USER=root
MYSQL_PASSWORD=

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379

# RabbitMQ Configuration
RABBITMQ_USER=root
RABBITMQ_PASS=root_password_123
RABBITMQ_HOST=rabbitmq

# MinIO Configuration
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123

# JWT Configuration
JWT_SECRET=your-secret-key-change-in-production-make-it-long-and-random
JWT_TTL=60
JWT_REFRESH_TTL=20160

# Mail Configuration (Mailhog for development)
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null

# App Configuration
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
